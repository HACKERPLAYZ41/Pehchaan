# ==============================================================================
# Pehchaan DRP - Backend Environment Configuration (.env)
# Copy this file to backend/.env (or root .env) and configure for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Environment & Security
# ------------------------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
APP_URL=https://pehchaan.blockcode.in
APP_SECRET=generate-a-secure-random-64-character-hex-key-here

# ------------------------------------------------------------------------------
# 2. Database Configuration
# Driver options: 'mysql' (cPanel Production) or 'sqlite' (Local testing)
# ------------------------------------------------------------------------------
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=blockcode_pehchaan
DB_USER=blockcode_pehchaan_user
DB_PASS=YourStrongDatabasePasswordHere
DB_CHARSET=utf8mb4

# SQLite path (used if DB_DRIVER=sqlite)
DB_SQLITE_PATH=database/pehchaan.sqlite

# ------------------------------------------------------------------------------
# 3. Security, Rate Limiting & DPDP Act 2023 Data Minimisation
# ------------------------------------------------------------------------------
# Maximum requests allowed within window per hashed IP
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Data retention limits (Strict India DPDP Act compliance)
WORKSPACE_TTL_DAYS=7
DISMISSED_TTL_DAYS=30

# ------------------------------------------------------------------------------
# 4. Discord Security Webhook Alerts
# Receives real-time alerts when HIGH/CRITICAL threats are flagged
# ------------------------------------------------------------------------------
DISCORD_ALERTS_ENABLED=true
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_MIN_SEVERITY=HIGH

# ------------------------------------------------------------------------------
# 5. AI / LLM Intelligence Service (Optional)
# Used for advanced takedown letter synthesis & semantic analysis via OpenRouter
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=
