# Pehchaan DRP Environment Configuration
# Copy this file to .env and configure with your cPanel MySQL and Discord Webhook details

APP_ENV=production
APP_DEBUG=false
APP_URL=https://pehchaan.blockcode.in
APP_SECRET=generate-a-secure-random-64-character-hex-key-here

# Database Configuration (cPanel MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=blockcode_pehchaan
DB_USER=blockcode_pehchaan_user
DB_PASS=YourStrongDatabasePasswordHere
DB_CHARSET=utf8mb4

# Security & Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
WORKSPACE_TTL_DAYS=7
DISMISSED_TTL_DAYS=30

# Discord Security Alert Webhook
# Paste your Discord channel webhook URL below to receive live security and threat alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_ALERTS_ENABLED=true
DISCORD_MIN_SEVERITY=HIGH
